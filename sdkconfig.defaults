# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.4.0 Project Minimal Configuration
#
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# SPIFFS stores full paths; the Linux-FHS layout (etc/, usr/share/, var/lib/)
# needs paths longer than the default 32 chars.
CONFIG_SPIFFS_OBJ_NAME_LEN=64
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=32768

# WiFi/LWIP buffers are allocated from PSRAM so esp_wifi_init() does not
# run out of contiguous internal DRAM (LVGL SPI DMA already uses it).
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ── Internal DRAM budget for BLE + WiFi ───────────────────────────────
# Boot was crashing with ESP_ERR_NO_MEM in esp_bt_controller_init() and
# esp_wifi_init() (DIRAM ~81% used).  These reclaim internal DRAM:
#   - Bluedroid env moved to dynamic (allocated from PSRAM first)
#   - WiFi code taken out of IRAM (WiFi is used briefly at boot, then deinit)
#   - fewer WiFi static RX/TX/mgmt buffers
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
# Static TX is FORCED when SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y (dynamic TX depends
# on it being off). Keep the internal-DRAM static TX count small; PSRAM cache
# TX buffers (32) pick up the slack.
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUFFER=y
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUF=1
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Enable FAT long filenames on SD card (required for timestamp filenames)
CONFIG_FATFS_LFN_HEAP=y

# USB pads are switched to OTG at runtime in tinyusb_msc_init()
# via usb_serial_jtag_otg_pad_enable(true).

# ?? Display: small draw buffer avoids PSRAM DMA chunk overflow ??????
# esp-bsp#716: Large PSRAM buffers + trans_size chunking cause
# "spi transmit (queue) color failed" on Waveshare SH8601 boards.
# Keeping buffer ??2KB (internal DRAM threshold) reduces chunk count
# from ~20 to ~8 per flush, preventing SPI queue overflow.
CONFIG_BSP_DISPLAY_LVGL_BUF_HEIGHT=25

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_8WAYS=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_LINE_32B=y
CONFIG_ESP32S3_DATA_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_4WAYS=y
CONFIG_ESP32S3_DATA_CACHE_LINE_32B=y

CONFIG_FREERTOS_HZ=1000
# ── Power management ──────────────────────────────────────────────────
# Explicit light sleep (esp_light_sleep_start) is used while the display is
# off, gated by the "light_sleep_enabled" config flag (fallback to the old
# CPU-keeps-polling standby if a unit glitches after wake).  PM_ENABLE /
# tickless idle stay OFF: we enter light sleep explicitly and never want
# FreeRTOS to auto-sleep in the middle of UI work.
CONFIG_PM_ENABLE=y
# CONFIG_FREERTOS_USE_TICKLESS_IDLE is not set
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768

# ── ULP-RISC-V wake-on-raise sampler ─────────────────────────────────
# The ULP-RISC-V coprocessor runs while the main CPU is in light sleep
# (display off, wake-on-raise on): it bit-bangs I2C to the QMI8658, keeps a
# 1.5s ring buffer in RTC slow memory and runs a pure-integer 3-layer CNN
# (wor_cnn.c) that wakes the CPU ONLY on a confirmed raise.  ~8 KB of RTC
# slow memory is reserved (8160 B — the app's .rtc.force_slow needs 32 B).
CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_RISCV=y
CONFIG_ULP_COPROC_RESERVE_MEM=8160
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
# CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM is not set
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_38=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_TXT_BREAK_CHARS=" ,.;:-_"
CONFIG_LV_USE_FS_STDIO=y
CONFIG_LV_FS_STDIO_LETTER=83
CONFIG_LV_FS_STDIO_PATH="/sdcard"
CONFIG_LV_USE_SNAPSHOT=y
# Runtime PNG decode stays available (lodepng) for future assets.  The Analog
# Hands face itself ships raw A8 alpha-mask .bin layers instead (tiny, no
# decode cost) — see tools/build_hands_face.py.
CONFIG_LV_USE_LODEPNG=y
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LV_USE_IMGFONT=y
CONFIG_LV_USE_DEMO_WIDGETS=y
CONFIG_LV_USE_DEMO_BENCHMARK=y
CONFIG_LV_USE_DEMO_RENDER=y
CONFIG_LV_USE_DEMO_SCROLL=y
CONFIG_LV_USE_DEMO_STRESS=y
CONFIG_LV_USE_DEMO_TRANSFORM=y
CONFIG_LV_USE_DEMO_MUSIC=y
CONFIG_LV_DEMO_MUSIC_AUTO_PLAY=y
CONFIG_LV_USE_DEMO_FLEX_LAYOUT=y
CONFIG_LV_USE_DEMO_MULTILANG=y
CONFIG_LV_USE_QRCODE=y
CONFIG_LV_USE_FLOAT=y
CONFIG_LV_USE_GESTURE_RECOGNITION=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# ?? WiFi ?????????????????????????????????????????????????????????????
CONFIG_ESP_WIFI_ENABLED=y

# ?? BLE (for provisioning) ???????????????????????????????????????????
CONFIG_BT_ENABLED=y

# ?? SNTP / NTP ???????????????????????????????????????????????????????
CONFIG_LWIP_SNTP_UPDATE_DELAY=3600000

# ?? UART console (faster = less blocking during boot log storm) ??????
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
